  },
  "_ATR_PRICE_RULES": {
    "_comment": "ATR-scaled entry/exit price levels. Multipliers apply to ATR-14 (dollar volatility per symbol), not a fixed % of price, so a low-ATR name and a high-ATR name each get an offset sized to how far they actually move.",
    "entry": {
      "buy_atr_mult":         1.0,
      "strong_buy_atr_mult":  2.0,
      "limit_below_atr_mult": 0.25,
      "_anchor_blend_comment": "The entry anchor blends smoothly from the 20d high toward MA50 as ATR-14 (% of price) rises from low_vol_atr_pct to high_vol_atr_pct — not a hard cutoff. A high-ATR name that's fallen hard often has a 20d high that was itself a blow-off top with no reversion value, so MA50 (trend-following) becomes the better reference; a binary switch only fixed the most extreme names (SOXX-level ~6%+ ATR) and left moderate ones (~2-3% ATR, e.g. AAPL/QQQM) with zero adjustment. Below low_vol_atr_pct, weight is 0 (pure 20d-high anchor, unchanged for calm names like ADX). At/above high_vol_atr_pct, weight is 1 (pure MA50 anchor).",
      "anchor_blend_low_vol_atr_pct":  1.5,
      "anchor_blend_high_vol_atr_pct": 5.0
    },
    "exit": {
      "stop_atr_mult":       2.0,
      "target_rr_multiple":  2.0
    },
    "swing": {
      "entry_pullback_atr_mult": 0.5,
      "stop_atr_mult":            1.5,
      "target_rr_multiple":       2.0
    },
    "swing_calendar_regime_atr_mult": {
