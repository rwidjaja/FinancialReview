      "CONSOLIDATION": { "watch": 0.5, "buy": 1.5, "strong": 2.5, "panic": 3.5 },
      "RISK-OFF":      { "watch": 0.5, "buy": 2.0, "strong": 3.0, "panic": 5.0 }
    }
